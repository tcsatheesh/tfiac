# Sample consumer of the terraform/dns/ stack outputs.
# Not applied — reference snippet for spoke / hub stacks that need to link
# vnets to the centralized Private DNS Zones (FR-005 / SC-001).

data "terraform_remote_state" "dns" {
  backend = "local"
  config  = { path = "../dns/terraform.tfstate" }
}

# Wire a spoke vnet to the Microsoft "blob" catalogue zone.
resource "azurerm_private_dns_zone_virtual_network_link" "blob" {
  name                  = "link-spoke-sp01-npd-to-blob"
  resource_group_name   = data.terraform_remote_state.dns.outputs.resource_group_name
  private_dns_zone_name = data.terraform_remote_state.dns.outputs.zone_names["blob"]
  virtual_network_id    = azurerm_virtual_network.spoke.id
  registration_enabled  = false
}

# Iterate over every catalogue + custom zone (Constitution-friendly):
resource "azurerm_private_dns_zone_virtual_network_link" "all" {
  for_each              = data.terraform_remote_state.dns.outputs.zone_names
  name                  = "link-spoke-sp01-npd-to-${replace(each.value, ".", "-")}"
  resource_group_name   = data.terraform_remote_state.dns.outputs.resource_group_name
  private_dns_zone_name = each.value
  virtual_network_id    = azurerm_virtual_network.spoke.id
  registration_enabled  = false
}
