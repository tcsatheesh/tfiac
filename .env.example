# .env.example
# Copy this file to .env and fill in the values. `.env` is gitignored.
# All scripts and the README -var invocations source from these names.

# --- GitHub identity (flows into the `repo` Terraform variable as
#     "$GITHUB_ORGANIZATION/$GITHUB_REPOSITORY") -------------------------
GITHUB_ORGANIZATION=<your-github-org>
GITHUB_REPOSITORY=<your-github-repo>

# --- Azure subscription IDs --------------------------------------------
# One entry per (env, scope) deployment target. Stacks read them via the
# `-var subscription_id=...` flag at plan time (see each terraform/<stack>/
# README for the canonical command).
#
# SUBSCRIPTION_ID_TOOL          -> terraform/bootstrap/    (tfstate storage)
# SUBSCRIPTION_ID_PRD_DNS       -> terraform/dns/    (env=prd, scope=hub)
# SUBSCRIPTION_ID_NPD_HUB       -> terraform/log/    (env=npd, scope=hub)
#                                 + terraform/vnet/  (env=npd, scope=hub, role=hub)
# SUBSCRIPTION_ID_NPD_SP01      -> terraform/vnet/   (env=npd, scope=sp01, role=spoke)
# SUBSCRIPTION_ID_PRD_HUB       -> terraform/log/    (env=prd, scope=hub)
# SUBSCRIPTION_ID_PRD_SP01      -> reserved for future prd spoke deployments

SUBSCRIPTION_ID_TOOL=<subscription-id-for-tfstate-tooling>
SUBSCRIPTION_ID_PRD_DNS=<subscription-id-for-prd-dns>
SUBSCRIPTION_ID_NPD_HUB=<subscription-id-for-npd-hub>
SUBSCRIPTION_ID_NPD_SP01=<subscription-id-for-npd-spoke-01>
SUBSCRIPTION_ID_PRD_HUB=<subscription-id-for-prd-hub>
SUBSCRIPTION_ID_PRD_SP01=<subscription-id-for-prd-spoke-01>
