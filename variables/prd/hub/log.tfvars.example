# Inputs for terraform/log/ targeting (env=prd, scope=hub).
# Copy to log.tfvars (gitignored) and pass via -var-file when running.
#
# `subscription_id` and `repo` are NOT set here — inject from .env at
# plan time:
#   terraform plan -var-file=.../log.tfvars \
#     -var "subscription_id=$SUBSCRIPTION_ID_PRD_HUB" \
#     -var "repo=$GITHUB_ORGANIZATION/$GITHUB_REPOSITORY"

region = "swedencentral"

topology    = "hub"
tenant      = "hub"
environment = "prd"

retention_in_days = 30
sku               = "PerGB2018"
