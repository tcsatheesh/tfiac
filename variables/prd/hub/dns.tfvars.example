# Inputs for terraform/dns/ targeting (env=prd, scope=hub).
# Copy to dns.tfvars (gitignored) and pass via -var-file when running.
#
# `subscription_id` and `repo` are NOT set here — inject from .env at
# plan time:
#   terraform plan -var-file=.../dns.tfvars \
#     -var "subscription_id=$SUBSCRIPTION_ID_PRD_DNS" \
#     -var "repo=$GITHUB_ORGANIZATION/$GITHUB_REPOSITORY"

region = "swedencentral"

topology    = "hub"
tenant      = "hub"
environment = "prd"

# Operator-supplied private DNS zones (FQDNs). Empty list is fine.
custom_zones = [
  "internal.contoso.local",
]

# Catalogue keys to skip (must exist in modules/dnszones/locals.tf catalogue).
disable_catalogue_zones = []
