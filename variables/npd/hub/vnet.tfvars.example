# Inputs for terraform/vnet/ targeting (env=npd, scope=hub, role=hub).
# Copy to vnet.tfvars (gitignored) and pass via -var-file when running.
#
# Apply order: hub stack first; each spoke second. After a new spoke
# exists, add its entry to `spoke_peerings` here and re-apply the hub.

subscription_id = "883c9081-23ed-4674-95c5-45c74834e093"
region          = "swedencentral"
repo            = "tcsatheesh/tfiac"

role        = "hub"
topology    = "hub"
tenant      = "hub"
environment = "npd"

address_space = ["10.240.4.0/23"]

# Subnet purpose -> CIDR. Keys feed the naming engine (snet-<purpose>-...).
# When role=hub the canonical add-on subnets must be present:
#   - "bastion"        (becomes AzureBastionSubnet)
#   - "firewall"       (becomes AzureFirewallSubnet)
#   - "firewall-mgmt"  (becomes AzureFirewallManagementSubnet)
subnets = {
  "development"    = "10.240.4.0/26"
  "pre-production" = "10.240.4.64/26"
  "api-management" = "10.240.4.144/28"
  "buildsvr"       = "10.240.4.160/28"
  "bastion"        = "10.240.4.192/28"
  "firewall"       = "10.240.5.0/26"
  "firewall-mgmt"  = "10.240.5.64/26"
}

# Hub-side leg of hub<->spoke peering. Each spoke stack must already exist
# (apply spoke first so its vnet ID is known). Add one entry here when a
# new spoke is provisioned, then re-apply the hub.
spoke_peerings = {
  "sp01-npd" = {
    remote_vnet_id   = "/subscriptions/883c9081-23ed-4674-95c5-45c74834e093/resourceGroups/rg-sp01-npd-sdc-001/providers/Microsoft.Network/virtualNetworks/vnet-sp01-npd-sdc-001"
    remote_vnet_name = "vnet-sp01-npd-sdc-001"
  }
}
