# Inputs for terraform/log/ targeting (env=npd, scope=hub).
# Copy to log.tfvars (gitignored) and pass via -var-file when running.

subscription_id = "883c9081-23ed-4674-95c5-45c74834e093"
region          = "swedencentral"
repo            = "tcsatheesh/tfiac"

# Env/scope discriminators — drive naming + tags.
topology    = "hub"
tenant      = "hub"
environment = "npd"

# Optional workspace settings.
retention_in_days = 30
sku               = "PerGB2018"
