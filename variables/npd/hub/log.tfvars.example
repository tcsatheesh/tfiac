# Inputs for terraform/log/ targeting (env=npd, scope=hub).
# Copy to log.tfvars (gitignored) and pass via -var-file when running.
#
# `subscription_id` and `repo` are NOT set here — inject from .env at
# plan time so secrets stay out of variables/:
#   terraform plan -var-file=.../log.tfvars \
#     -var "subscription_id=$SUBSCRIPTION_ID_NPD_HUB" \
#     -var "repo=$GITHUB_ORGANIZATION/$GITHUB_REPOSITORY"

region = "swedencentral"

# Env/scope discriminators — drive naming + tags.
topology    = "hub"
tenant      = "hub"
environment = "npd"

# Optional workspace settings.
retention_in_days = 30
sku               = "PerGB2018"
