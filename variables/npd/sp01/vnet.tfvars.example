# Inputs for terraform/vnet/ targeting (env=npd, scope=sp01, role=spoke).
# Copy to vnet.tfvars (gitignored) and pass via -var-file when running.
#
# Apply order: hub vnet stack first, then this spoke. The spoke reads the
# hub's vnet_id + firewall_private_ip + peered_spoke_vnet_names from the
# hub's remote state via `hub_state_backend` below.

subscription_id = "883c9081-23ed-4674-95c5-45c74834e093"
region          = "swedencentral"
repo            = "tcsatheesh/tfiac"

role        = "spoke"
topology    = "spoke"
tenant      = "sp01"
environment = "npd"

address_space = ["10.240.2.0/24"]

# Subnet purpose -> CIDR. Spokes typically only declare workload subnets.
subnets = {
  "development"    = "10.240.2.0/26"
  "pre-production" = "10.240.2.64/26"
  "logic-app"      = "10.240.2.128/28"
  "function-app"   = "10.240.2.144/28"
  "preprod-logic"  = "10.240.2.160/28"
  "preprod-func"   = "10.240.2.176/28"
}

# Locate the hub vnet stack's tfstate in Azure Storage. The `key` follows
# our convention `<env>/<scope>/vnet.tfstate`.
hub_state_backend = {
  resource_group_name  = "rg-hub-tool-sdc-001"
  storage_account_name = "sthubtoolsdc001"
  container_name       = "tfstate"
  key                  = "npd/hub/vnet.tfstate"
}
