# Inputs for terraform/bootstrap/ (provisions the tfstate storage account).
# Run once per subscription; uses the LOCAL backend (never the azurerm one).
#
# `subscription_id` and `repo` are NOT set here — inject from .env at
# plan time:
#   terraform plan -var-file=.../bootstrap.tfvars \
#     -var "subscription_id=$SUBSCRIPTION_ID_PRD_HUB" \
#     -var "repo=$GITHUB_ORGANIZATION/$GITHUB_REPOSITORY"

region      = "swedencentral"
environment = "tool"
