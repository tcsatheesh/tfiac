# Shared azurerm partial-backend config — pass via
#   terraform init -reconfigure \
#     -backend-config=../../variables/backend.hcl \
#     -backend-config="key=<env>/<scope>/<service>.tfstate"
#
# These four values are emitted as the `backend_config_snippet` output of
# the terraform/bootstrap/ stack. Per-stack `key` is supplied separately.

resource_group_name  = "rg-hub-tool-sdc-001"
storage_account_name = "sthubtoolsdc001"
container_name       = "tfstate"
use_azuread_auth     = true
